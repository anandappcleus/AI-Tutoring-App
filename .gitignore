chroma_db/
.chroma/

# ── RAG corpus PDFs (too large for git) ──────────────────────────────
backend/rag/corpus/

# ── Node (build_plan.js tooling) ─────────────────────────────────────
node_modules/
npm-debug.log*
package-lock.json

# ── Generated output docs ────────────────────────────────────────────
*.docx

