# ── LLM (Dev: NVIDIA NIM) ────────────────────────────────────────────
LLM_BASE_URL=https://integrate.api.nvidia.com/v1
LLM_API_KEY=nvapi-xxxx          # get yours free at build.nvidia.com
LLM_CHAT_MODEL=ai21labs/sarvam-m
LLM_AGENT_MODEL=qwen/qwen3-235b-a22b
EMBED_MODEL=nvidia/nv-embedqa-e5-v5

# ── Vector DB ────────────────────────────────────────────────────────
VECTOR_DB=chroma                 # local — no setup needed

# ── Database ─────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://user:pass@localhost:5432/tutordb

# ── Auth ─────────────────────────────────────────────────────────────
SECRET_KEY=change-me-in-production-use-a-long-random-string

# ── App ──────────────────────────────────────────────────────────────
APP_ENV=development
CORS_ORIGINS=["http://localhost:3000","http://localhost:8080"]
